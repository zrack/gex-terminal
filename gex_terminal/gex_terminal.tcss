Screen {
    background: #0b1016;
    color: #e9eef3;
}
Header {
    background: #171a1e;
    color: #e9b96e;
    text-style: bold;
}
HeaderIcon { display: none; }
HeaderTitle { content-align: left middle; }
Footer { background: #171a1e; color: #c3ced8; }
#session-summary { height: 3; padding: 0 2; background: #0b1016; }
#minimum-size-message {
    display: none;
    height: 1fr;
    padding: 2;
    content-align: center middle;
    color: #e9b96e;
}
#dashboard {
    height: 1fr;
    layout: grid;
    grid-size: 2 3;
    grid-columns: 1fr 35;
    grid-rows: 6 1fr 5;
    background: #0b1016;
}
#sidebar, #event-panel, .secondary-metric { display: none; }
#top-metrics {
    column-span: 2;
    layout: grid;
    grid-size: 4 1;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-rows: 1fr;
    grid-gutter: 1;
    padding: 0 1;
    margin-bottom: 1;
}
.metric-card {
    border-left: thick #354352;
    padding: 0 1;
    background: #131b24;
    height: 100%;
}
.metric-label { height: 1; color: #a9b6c4; text-style: bold; }
.metric-value { height: 1; text-style: bold; color: #e9eef3; margin-top: 1; }
.metric-foot { height: 1; color: #a9b6c4; }
#matrix-panel { border-right: solid #354352; padding: 0 2; background: #0f161e; }
#structure-panel { padding: 0 1; background: #0f161e; overflow-y: auto; }
#flow-panel { border-top: solid #354352; border-right: solid #354352; padding: 0 2; }
#quality-panel { border-top: solid #354352; padding: 0 1; }
.section-title { height: 1; color: #e9b96e; text-style: bold; }
.subtle { color: #a9b6c4; height: 1; }
#matrix-controls { height: 1; margin-bottom: 1; color: #9aaaba; }
#structure-meta { margin-bottom: 1; }
.zone-card {
    height: auto;
    min-height: 4;
    border-left: solid #354352;
    background: #131b24;
    margin-bottom: 1;
    padding: 0 1;
}
.regime-card { height: auto; min-height: 6; padding: 0 1; background: #131b24; }
Screen.compact #balance-pressure, Screen.compact #regime-map { display: none; }
.quality-card { overflow-y: auto; height: 2; color: #c3ced8; }
.state-banner { height: auto; min-height: 1; text-style: bold; margin-bottom: 1; }
#status-bar { height: 1; background: #0b1016; color: #a9b6c4; padding: 0 1; }
DataTable { height: 1fr; background: #0f161e; }
DataTable > .datatable--header { background: #202b36; color: #c3ced8; text-style: bold; }
DataTable > .datatable--cursor { background: #24414d; color: #e9eef3; }
DataTable:focus { border-bottom: solid #67d2e3; }
Sparkline { height: 2; }
#flow-message { height: 2; color: #a9b6c4; }
ReplayPicker, ResearchInfo { align: center middle; background: #05080cbf; }
.research-dialog {
    width: 88;
    max-width: 94%;
    height: 28;
    max-height: 90%;
    border: round #e9b96e;
    padding: 1 2;
    background: #111922;
}
.dialog-eyebrow { height: 1; color: #e9b96e; text-style: bold; }
.dialog-subtitle { height: 1; color: #a9b6c4; margin-bottom: 1; }
#replay-options { height: 1fr; border: none; background: #0b1016; padding: 0 1; }
#replay-options > .option-list--option-highlighted { background: #24414d; color: #e9eef3; text-style: bold; }
#replay-description { height: 5; padding: 1 0 0 0; color: #c3ced8; }
.dialog-hint { height: 1; color: #a9b6c4; margin-top: 1; }
#replay-error { height: auto; max-height: 2; color: #fb7185; }
#info-scroll { height: 1fr; margin-top: 1; }
#info-content { height: auto; }
ReplayPicker Footer, ResearchInfo Footer { dock: bottom; }
